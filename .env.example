# Copy to .env and fill in. Note that .env is gitignored and will never be committed.

# ==============================================================================
# 1. LLM & OpenRouter Configuration
# ==============================================================================
# Works with OpenRouter, OpenAI, or any OpenAI-compatible provider (vLLM, Ollama)
# Get a free OpenRouter API key at: https://openrouter.ai/settings/keys

OPENROUTER_API_KEY=sk-or-v1-your-openrouter-api-key-here
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=sk-or-v1-your-openrouter-api-key-here

# OpenRouter Free Tier Model Options:
# Option A (Recommended): cohere/north-mini-code:free (fast, reliable JSON formatting)
# Option B (Qwen 27B):    qwen/qwen3.8-27b:free
# Option C (Llama 70B):   meta-llama/llama-3.3-70b-instruct:free
OPENAI_MODEL=cohere/north-mini-code:free

# Standard OpenAI Alternative (if using official OpenAI API):
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=sk-proj-your-openai-key-here
# OPENAI_MODEL=gpt-4o-mini

# Embeddings configuration (defaults to text-embedding-3-small or local fallback)
EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
# EMBEDDING_API_KEY=sk-or-v1-...

# ==============================================================================
# 2. GitHub Personal Access Token
# ==============================================================================
# Create a token at: https://github.com/settings/tokens (classic)
# Required Scope: public_repo (for public repos) or repo (for private repos)
# Increases GitHub API rate limit from 60 to 5,000 requests/hour for repo ingestion.
GITHUB_TOKEN=ghp_your_github_personal_access_token_here

# ==============================================================================
# 3. Database Configuration
# ==============================================================================
# PostgreSQL connection string with pgvector extension enabled
DATABASE_URL=postgresql://kairo:kairo@localhost:5433/kairo

# ==============================================================================
# 4. Target Repository
# ==============================================================================
# Default target repository for ingestion and GraphRAG exploration
TARGET_REPO=sharvarianand/kairo
