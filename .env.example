# Copy to .env and fill in. .env is gitignored.

# --- LLM ---
# Works with OpenRouter, OpenAI proper, or any OpenAI-compatible proxy (vLLM, Ollama...)
# Default recommended free configuration via OpenRouter:
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=sk-or-v1-...
OPENAI_MODEL=cohere/north-mini-code:free

# Standard OpenAI alternative:
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# Embeddings may live on a different endpoint than chat on some proxies.
# Leave unset to reuse OPENAI_BASE_URL / OPENAI_API_KEY, or local fallback will be used.
EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_BASE_URL=
# EMBEDDING_API_KEY=

# --- GitHub ---
# github.com/settings/tokens -> classic -> scope: public_repo
# Without this you get 60 req/hour instead of 5000, which makes ingestion impractical.
GITHUB_TOKEN=ghp_...

# --- Database ---
DATABASE_URL=postgresql://kairo:kairo@localhost:5433/kairo

# --- Target repo for ingestion ---
TARGET_REPO=fastapi/fastapi
